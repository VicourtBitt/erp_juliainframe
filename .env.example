# Copy to .env and adjust. Never commit the real .env.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://seu-app.herokuapp.com

# Database (defaults to SQLite). The Supabase Postgres connection string works here.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Google Gemini (contract creator + market analysis)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash

# Optional S3-compatible storage for uploaded files (required on Heroku: its disk is ephemeral)
# AWS_STORAGE_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_REGION_NAME=
# AWS_S3_ENDPOINT_URL=   # e.g. Supabase Storage / Cloudflare R2 S3 endpoint

# Legacy import (python manage.py import_legacy)
# SUPABASE_URL=
# SUPABASE_KEY=
# MONGO_URI=
# MONGO_DB=
